{
  "name": "dsh-plugin-image-tools",
  "description": "DSH 图片插件，三个工具覆盖三种场景：ask_user_choice 图片/图文混合选择卡（Web GUI 渲染，可放大查看）+ show_images 回复内嵌图片（图文混排）+ save_received_images 盲模型收图存为工作区文件；聊天栏所有图片点击放大，支持滚轮缩放与拖拽平移。来源支持本地路径 / http(s) URL / base64 data URI。零 token 本地渲染，纯插件实现不改核心包。",
  "version": "0.6.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "设计说明.md"
  ],
  "scripts": {
    "selfcheck": "node scripts/selfcheck.mjs",
    "smoke": "node scripts/selfcheck.mjs && node scripts/smoke-server.mjs && node scripts/smoke-client.mjs",
    "pack": "npm pack",
    "prepublishOnly": "npm run smoke"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "ask",
    "choice",
    "image",
    "image-picker",
    "picker",
    "show",
    "inline",
    "inline-image",
    "lightbox",
    "zoom",
    "multimodal",
    "vision",
    "attachment"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pasumao/dsh-plugin-image-tools.git"
  },
  "homepage": "https://github.com/Pasumao/dsh-plugin-image-tools#readme",
  "bugs": {
    "url": "https://github.com/Pasumao/dsh-plugin-image-tools/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
